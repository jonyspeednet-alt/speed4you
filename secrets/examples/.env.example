# Master local .env template — copy to ***REMOVED***s/local/.env and fill in real values.
#
# This file is COMMITTED (under ***REMOVED***s/examples/) as a reference. The real
# file lives at ***REMOVED***s/local/.env and is gitignored. Never put real values
# in this template.

# ─────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=1

# ─────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=isp_entertainment
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=20

# ─────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────
# Generate a strong ***REMOVED*** with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_chars
ADMIN_USERNAME=admin
# Generate a bcrypt hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your_***REMOVED***', 10))"
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash

# ─────────────────────────────────────────────────────────
# CORS — REQUIRED in production
# ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# ─────────────────────────────────────────────────────────
# External API keys (metadata enrichment)
# ─────────────────────────────────────────────────────────
TMDB_API_KEY=
OMDB_API_KEY=

# ─────────────────────────────────────────────────────────
# Media / Player Cache
# ─────────────────────────────────────────────────────────
PLAYER_CACHE_ROOT=/var/www/html/Extra_Storage/portal-media-cache
SCANNER_CACHE_DIR=/var/www/html/Extra_Storage/scanner-cache
MEDIA_NORMALIZER_TEMP_DIR=/tmp/media-normalizer
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ─────────────────────────────────────────────────────────
# Rate limits (tune per deployment)
# ─────────────────────────────────────────────────────────
GLOBAL_API_RATE_LIMIT_MAX=5000
PUBLIC_API_RATE_LIMIT_MAX=20000
PUBLIC_API_PER_IP_LIMIT=200

# ─────────────────────────────────────────────────────────
# Player (concurrent HLS streams)
# ─────────────────────────────────────────────────────────
PLAYER_MAX_CONCURRENT_LIVE_STREAMS=10

# ─────────────────────────────────────────────────────────
# Deploy (used by GitHub Actions)
# ─────────────────────────────────────────────────────────
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_SSH_KEY_PATH=./deploy_key
SUDO_PASSWORD=
DEPLOY_ENV_FILE_CONTENT=

# ─────────────────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────────────────
SCANNER_HEALTH_PUBLIC_VERBOSE=false

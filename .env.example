# =============================================================================
# Speed4You Portal - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# --- Node Environment ---
NODE_ENV=production

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=isp_entertainment
DB_USER=your_db_user
DB_PASSWORD=your_db_***REMOVED***
DB_POOL_MAX=50
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# --- Authentication ---
JWT_SECRET=your_jwt_***REMOVED***_min_32_chars_long
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_***REMOVED***

# --- API Keys ---
TMDB_API_KEY=your_tmdb_api_key
OMDB_API_KEY=your_omdb_api_key

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://data.speed4you.net,https://103.79.182.226,capacitor://localhost,http://localhost

# --- Scanner ---
SCANNER_MIN_MOVIE_SIZE=104857600
SCANNER_MIN_EPISODE_SIZE=31457280
SCANNER_RECONCILIATION_SEARCH_DEPTH=5
SCANNER_MAX_NEW_ROOTS_PER_SCAN=30

# --- Webhook (for local deployment) ---
WEBHOOK_SECRET=your_webhook_***REMOVED***_here

# --- Server ---
PORT=4100
